{
  "expo": {
    "name": "Banter",
    "slug": "roast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roast",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/roast.icon",
      "supportsTablet": false,
      "bundleIdentifier": "group.flingex.roast.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location is used to support features that may require it, such as localized services.",
        "CFBundleLocalizations": ["en", "de", "fr", "es", "ja", "pt", "it"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.flingex.roast.onesignal",
          "group.group.flingex.roast.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.RECORD_AUDIO"],
      "package": "group.flingex.roast.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Banter uses your photos only when you choose to generate playful reply suggestions."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "de", "fr", "es", "ja", "pt", "it"],
            "android": ["en", "de", "fr", "es", "ja", "pt", "it"]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.2"
          }
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "iPhoneDeploymentTarget": "16.2"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "roast",
          "organization": "ademola-kevin-bello"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "group.flingex.roast.app.expo-sharing-extension",
                  "entitlements": []
                }
              ]
            }
          }
        },
        "projectId": "e134cd92-cdfd-4d9c-bd4c-ac721e780c1d"
      }
    }
  }
}
